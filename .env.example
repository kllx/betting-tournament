PORT=3000
TRUST_PROXY=0
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/betting_tournament
DATABASE_MIGRATIONS_RUN=true
REDIS_URL=redis://localhost:56379
REDIS_MAX_RETRIES_PER_REQUEST=3
REDIS_COMMAND_TIMEOUT_MS=1000
REDIS_CONNECT_TIMEOUT_MS=5000
ADMIN_API_TOKEN=local-admin-token
EVENT_SIGNING_SECRET=local-external-event-signing-secret-32
INTERNAL_EVENT_SIGNING_SECRET=local-internal-event-signing-secret-32
MAX_WIN_AMOUNT_USD=100000
MAX_EVENT_BYTES=16384
RATE_LIMIT_ADMIN_WINDOW_MS=60000
RATE_LIMIT_ADMIN_MAX_REQUESTS=30
RATE_LIMIT_LEADERBOARD_WINDOW_MS=1000
RATE_LIMIT_LEADERBOARD_MAX_REQUESTS=1000
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=betting
RABBITMQ_QUEUE=tournament.bets
RABBITMQ_PREFETCH=20
RABBITMQ_RETRY_TTL_MS=1000
RABBITMQ_MAX_RETRIES=3
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL_MS=100
OUTBOX_PUBLISH_CONCURRENCY=10
SHUTDOWN_GRACE_PERIOD_MS=5000
SHUTDOWN_CONNECTION_CHECK_INTERVAL_MS=100
SHUTDOWN_WORKER_DRAIN_TIMEOUT_MS=5000
RABBITMQ_RECONNECT_DELAY_MS=1000
LEADERBOARD_RECONCILE_INTERVAL_MS=60000
TOURNAMENT_END_AT=2099-12-31T23:59:59.000Z
TOURNAMENT_SETTLEMENT_GRACE_MS=600000
TOURNAMENT_FINALIZE_AFTER_MS=900000
TOURNAMENT_FINALIZER_INTERVAL_MS=1000
TOURNAMENT_PRIZES=[1000,500,250]
FX_RATES={"USD":1,"EUR":1.1,"RUB":0.011}
RATE_LIMIT_POSTGRES_FALLBACK_WINDOW_MS=1000
RATE_LIMIT_POSTGRES_FALLBACK_MAX_REQUESTS=100
OUTBOX_RETENTION_DAYS=7
BET_EVENTS_RETENTION_DAYS=30
RETENTION_BATCH_SIZE=10000
RETENTION_CLEANUP_INTERVAL_MS=3600000
LEADERBOARD_ACTIVE_PHASE_TTL_MS=1000
BET_EVENT_IDS_RETENTION_DAYS=90
BET_EVENT_IDS_ARCHIVE_RETENTION_DAYS=365
RABBITMQ_PUBLISH_CONFIRM_TIMEOUT_MS=5000
OUTBOX_MAX_ATTEMPTS=5
LEADERBOARD_READY_WAIT_MS=30000
