{
  "name": "betting-tournament",
  "version": "1.0.0",
  "private": true,
  "description": "Betting tournament leaderboard service",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/src/main.js",
    "start:dev": "nest start --watch",
    "producer": "ts-node src/producer.ts",
    "benchmark:fingerprint": "ts-node scripts/benchmark-fingerprint.ts",
    "load:bet-events": "ts-node scripts/load-bet-events.ts",
    "load:leaderboard": "docker run --rm -i --add-host=host.docker.internal:host-gateway -v \"$PWD/load/k6:/scripts\" -v \"$PWD/load/results:/scripts/results\" -e BASE_URL=http://host.docker.internal:3000 -e RATE=5000 -e DURATION=10s grafana/k6 run /scripts/leaderboard.js",
    "typeorm": "typeorm-ts-node-commonjs -d src/database/data-source.ts",
    "migration:run": "npm run typeorm migration:run",
    "migration:cutover": "ts-node scripts/migrate-bet-events-cutover.ts",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "npm run lint && npm run typecheck",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.{json,md,yml}\""
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@prometheus-io/client": "^0.16.1",
    "amqplib": "^0.10.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "ioredis": "^5.11.1",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "overrides": {
    "deepmerge": "4.3.1",
    "glob": "14.0.6",
    "minimatch": "11.0.8"
  }
}
